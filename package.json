{
  "name": "@comapeo/node-server",
  "version": "0.0.1",
  "description": "Minimal Node.js adapter that runs fetch-style (Request, ctx) => Response handlers on a node:http server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digidem/comapeo-node-server.git"
  },
  "homepage": "https://github.com/digidem/comapeo-node-server#readme",
  "bugs": {
    "url": "https://github.com/digidem/comapeo-node-server/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist/src"
  ],
  "scripts": {
    "format": "prettier --write .",
    "prepack": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "run-s test:types test:lint test:node",
    "test:types": "tsc",
    "test:lint": "eslint .",
    "test:node": "c8 node --test test/*.test.js",
    "bench": "node bench/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "@whatwg-node/server": "^0.10.17",
    "c8": "^10.1.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "hono-node-server-v1": "npm:@hono/node-server@^1.19.14",
    "hono-node-server-v2": "npm:@hono/node-server@^2.0.4",
    "itty-router": "^5.0.18",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "custom-error-creator": "^1.4.0"
  }
}
