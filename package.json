{
	"name": "@comapeo/node-server",
	"version": "1.0.0",
	"description": "Minimal Node.js adapter that runs fetch-style (Request, ctx) => Response handlers on a node:http server.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/digidem/comapeo-node-server.git"
	},
	"homepage": "https://github.com/digidem/comapeo-node-server#readme",
	"bugs": {
		"url": "https://github.com/digidem/comapeo-node-server/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"sideEffects": false,
	"main": "./src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./src/index.js"
		}
	},
	"files": [
		"src",
		"dist/src"
	],
	"scripts": {
		"prepare": "husky",
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"format": "prettier --write .",
		"test": "run-s test:types test:lint test:unused test:unit",
		"test:types": "tsc",
		"test:lint": "eslint",
		"test:unused": "knip",
		"test:unit": "node --test \"test/**/*.test.js\"",
		"coverage": "c8 --reporter=lcov --reporter=text node --test \"test/**/*.test.js\"",
		"check:pkg": "npm run build && publint && attw --pack --profile esm-only",
		"bench": "npm --prefix bench run bench"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^22.20.5",
		"c8": "^12.0.0",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"itty-router": "^5.0.18",
		"knip": "^6.42.1",
		"lint-staged": "^17.6.0",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"rimraf": "^6.0.1",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.0"
	},
	"dependencies": {
		"custom-error-creator": "^1.4.0"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"useTabs": true,
		"importOrder": [
			"^node:",
			"<THIRD_PARTY_MODULES>",
			"^[./]"
		],
		"importOrderSeparation": true,
		"plugins": [
			"@trivago/prettier-plugin-sort-imports"
		],
		"overrides": [
			{
				"files": "*.md",
				"options": {
					"useTabs": false
				}
			}
		]
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts}": "eslint --cache --fix",
		"*": "prettier --write --ignore-unknown"
	},
	"knip": {
		"workspaces": {
			".": {},
			"bench": {
				"entry": [
					"*.mjs"
				]
			}
		}
	}
}
